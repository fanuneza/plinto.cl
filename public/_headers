/404
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/about
  Cache-Control: public, max-age=0, must-revalidate

/contact
  Cache-Control: public, max-age=0, must-revalidate

/service
  Cache-Control: public, max-age=0, must-revalidate

/work
  Cache-Control: public, max-age=0, must-revalidate

/work/*
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/scripts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; frame-src 'none'
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
