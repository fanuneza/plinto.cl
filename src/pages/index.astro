---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WorkGrid from "@/components/WorkGrid.astro";
import ServiceList from "@/components/ServiceList.astro";
import Icon from "@/components/Icon.astro";
import { FadeIn } from "@/components/motion";
import stoneHeroLeft from "@/assets/images/decorative/stone-hero-left.png";
import stoneHeroRight from "@/assets/images/decorative/stone-hero-right.png";
import stoneStack from "@/assets/images/decorative/stone-stack.png";

const works = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const services = [
  {
    icon: "dna",
    title: "Identidad de marca",
    body: "Desarrollo de identidad de marca con un lenguaje visual cohesivo que resuene con su público objetivo.",
    points: ["Narrativa", "Estrategia de Marca", "Identidad Visual"],
  },
  {
    icon: "mobile",
    title: "Estrategias en redes",
    body: "Creación de estrategia y material para difusión de proyectos y productos en RRSS, newsletters y web.",
    points: ["Estrategia por usuario y canales", "Creación de Contenido Orgánico", "Creación de Contenido Pagado"],
  },
  {
    icon: "image",
    title: "Creación de contenido",
    body: "Creación de packs de contenido audiovisual y editorial para distintos medios y difusión según objetivos del cliente.",
    points: [
      "Producción Audiovisual: Fotografía, Video, Visualización 3D, Ilustraciones",
      "Artículos y Posts - SEO",
      "Newsletters",
    ],
  },
  {
    icon: "cluster",
    title: "Consultorías",
    body: "Apoyamos el crecimiento de tu marca o proyecto desde el ángulo que necesites.",
    points: ["Campañas de difusión y awareness", "Visión y misión de empresa", "Captación de nuevos clientes"],
  },
] as const;
---

<BaseLayout title="Plinto | Contenido y comunicación para arquitectura" titleTemplate="%s">
  <section class="hero">
    <Image
      class="hero-stone hero-stone--left"
      src={stoneHeroLeft}
      alt=""
      role="presentation"
      aria-hidden="true"
      width={360}
      height={334}
      widths={[130, 260, 360]}
      sizes="(max-width: 809px) 130px, (max-width: 1409px) 22vw, 310px"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <Image
      class="hero-stone hero-stone--right"
      src={stoneHeroRight}
      alt=""
      role="presentation"
      aria-hidden="true"
      width={310}
      height={301}
      widths={[112, 224, 310]}
      sizes="(max-width: 809px) 112px, (max-width: 1421px) 19vw, 270px"
      loading="eager"
      decoding="async"
      fetchpriority="low"
    />
    <div class="hero-content">
      <h1 class="hero-fade-in" style="--hero-delay: 0s">plinto</h1>
      <p class="tagline hero-fade-in" style="--hero-delay: 0.15s">estrategia de marca y contenido</p>
      <div class="scroll-cue hero-fade-in" style="--hero-delay: 0.3s">
        <span>Conoce Plinto</span>
        <a href="#somos" aria-label="Ir a la sección sobre Plinto"><Icon name="arrow-down" size={18} /></a>
      </div>
    </div>
  </section>

  <FadeIn onLoad>
    <section class="brand-intro page-section">
      <div class="brand-intro-inner">
        <h2>Elevamos la identidad de tu marca desde la narrativa, la estética visual y el contenido creativo</h2>
        <Icon name="asterisk" size={24} class="asterisk" />
        <div class="intro-services">
          <p>
            <strong>Identidad de marca</strong><br />Construimos identidad de marca y rescatamos el valor intrínseco.
          </p>
          <p><strong>Narrativa</strong><br />Traducimos la esencia de una marca en una narrativa potente.</p>
          <p><strong>Marketing de contenidos</strong><br />Creamos contenido que posiciona y comunica.</p>
        </div>
      </div>
    </section>
  </FadeIn>

  <FadeIn>
    <section id="somos" class="somos-section page-section">
      <div class="somos-inner">
        <h2>Somos Plinto</h2>
        <div class="definition">
          <p>Del lat. <em>plinthus</em>, y este del gr. πλίνθος <em>plínthos</em>;</p>
          <ol>
            <li>base que sostiene y eleva un pilar o estructura</li>
            <li>estructura fundamental sobre la que se desarrolla y sostiene una identidad clara y coherente</li>
          </ol>
        </div>
        <Image
          class="stacked-stone"
          src={stoneStack}
          alt=""
          role="presentation"
          aria-hidden="true"
          width={460}
          height={460}
          loading="lazy"
          fetchpriority="low"
          decoding="async"
        />
        <div class="somos-copy">
          <p>
            No venimos del marketing tradicional, sino de la arquitectura, la observación y el contenido creativo. Y
            desde ahí, proponemos otra forma de habitar el marketing y la comunicación: elevar la conversación, darle
            forma a la identidad de quienes construyen ciudad y recordar que detrás de cada proyecto hay una historia
            que merece ser bien contada.
          </p>
          <p>
            En un mundo saturado de imágenes sin relato, la narrativa clara y visual es un acto de posicionamiento y
            observamos este panorama como agentes culturales. Plinto es un estudio de estrategia, contenido y
            comunicación que construye marcas relevantes en el mundo de la arquitectura y la construcción a través de
            una narrativa coherente y distintiva.
          </p>
        </div>
      </div>
    </section>
  </FadeIn>

  <FadeIn>
    <section class="portfolio-section page-section">
      <div class="portfolio-head source-head">
        <div>
          <h2 class="kicker">Portafolio</h2>
          <p class="intro-copy">
            Colección de proyectos y campañas realizadas entre 2012 y 2025 para ArchDaily y clientes privados.
          </p>
          <p class="intro-copy small-copy">
            Contamos con más de 13 años de experiencia en creación de contenido para marcas relacionadas a la
            arquitectura y construcción otorgando una mirada editorial aplicada a un objetivo comercial.
          </p>
        </div>
        <a class="round-link" href="/work/"
          ><span>Ver todos los proyectos</span><span class="round-link__arrow" aria-hidden="true"
            ><Icon name="arrow-right" size={14} /></span
          ></a
        >
      </div>
      <WorkGrid items={works} limit={4} />
    </section>
  </FadeIn>

  <FadeIn>
    <section class="services-section page-section">
      <div class="center-head">
        <h2>Qué creamos</h2>
        <p>
          Especialistas en traducir el conocimiento técnico en una comunicación clara y accesible que combina la
          creatividad y la estética con un sentido mayor y coherente. Trabajamos con una mirada editorial aplicada a un
          objetivo comercial.
        </p>
      </div>
      <ServiceList items={services} headingLevel="h3" />
    </section>
  </FadeIn>

  <FadeIn>
    <section class="audience-section page-section">
      <div class="center-head">
        <h2>Áreas y clientes</h2>
        <p>Cómo ayudamos a distintos agentes del rubro.</p>
      </div>
      <div class="audience-grid">
        <FadeIn>
          <article>
            <h3>Arquitectos independientes o estudios de arquitectura</h3>
            <p>
              <strong>Impulsamos la difusión de tu trabajo, rescatando la esencia de tu obra.</strong> Creamos una narrativa
              coherente que comunica tu visión, fortalece tu identidad de marca y gestiona estratégicamente los canales digitales
              para posicionar tu estudio y tus proyectos.
            </p>
          </article>
        </FadeIn>
        <FadeIn delay={0.08}>
          <article>
            <h3>Empresas y marcas de materiales de construcción</h3>
            <p>
              Traducimos el valor técnico de tus productos en un <strong>relato claro y atractivo.</strong> Te ayudamos a
              conectar con arquitectos, constructoras y especificadores mediante una estrategia de marca, contenido visual
              y digital que pone en valor tu propuesta.
            </p>
          </article>
        </FadeIn>
        <FadeIn delay={0.16}>
          <article>
            <h3>Inmobiliarias y corredoras de propiedades</h3>
            <p>
              Promovemos proyectos desde una mirada <strong>arquitectónica y estratégica.</strong> Creamos contenido atractivo,
              profesional y coherente que comunica el valor del diseño, potencia la identidad de cada proyecto y mejora la
              conversión de tu comunicación digital.
            </p>
          </article>
        </FadeIn>
      </div>
    </section>
  </FadeIn>
</BaseLayout>
