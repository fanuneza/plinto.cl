---
import BaseLayout from "../layouts/BaseLayout.astro";
import FuzzyRedirect from "@jdevalk/astro-seo-graph/FuzzyRedirect.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="La pagina solicitada no existe o cambio de ruta. Revisa la sugerencia automatica o vuelve al inicio de Plinto."
  canonicalPath="/404"
  robots="noindex,follow"
>
  <section class="error-page page-section">
    <h1>Página no encontrada</h1>
    <p>Error 404 — La página que buscas no existe.</p>

    <div style="margin: 1.5rem 0; font-weight: 500;">
      <FuzzyRedirect />
    </div>

    <a class="link-row" href="/">Volver al inicio</a>
  </section>
</BaseLayout>
