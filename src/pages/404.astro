---
import BaseLayout from "../layouts/BaseLayout.astro";
import FuzzyRedirect from "@jdevalk/astro-seo-graph/FuzzyRedirect.astro";
import { FadeIn } from "../components/motion";
---

<BaseLayout
  title="Página no encontrada (Error 404)"
  description="La página solicitada no existe o cambió de ruta. Revisa la sugerencia automática o vuelve al inicio de Plinto."
  canonicalPath="/404"
  robots="noindex,follow"
>
  <FadeIn>
    <section class="error-page page-section">
      <h1>Página no encontrada</h1>
      <p>Error 404 — La página que buscas no existe.</p>

      <div class="error-suggestions">
        <FuzzyRedirect />
      </div>

      <a class="link-row" href="/">Volver al inicio</a>
    </section>
  </FadeIn>
</BaseLayout>
