---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contacto" description="Contacta a Plinto en Santiago, Chile.">
  <SectionTitle title="CONTACTO" />
  <section class="page-section contact-section">
    <div class="contact-links">
      <p><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><span>Email</span><a href={`mailto:${site.secondaryEmail}`}>{site.secondaryEmail}</a></p>
      <p><span>Instagram</span><a href={site.instagram} rel="noopener">Instagram</a></p>
      <p><span>LinkedIn</span><a href={site.linkedin} rel="noopener">LinkedIn</a></p>
    </div>
  </section>
</BaseLayout>
