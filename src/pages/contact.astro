---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contacto" description="Contacta a Plinto en Santiago, Chile.">
  <SectionTitle title="CONTACTO" />
  <section class="page-section contact-section">
    <address>
      <ul class="contact-links">
        <li><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><span>Email</span><a href={`mailto:${site.secondaryEmail}`}>{site.secondaryEmail}</a></li>
        <li><span>Instagram</span><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><span>LinkedIn</span><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
    </address>
  </section>
</BaseLayout>
