---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";

const people = [
  {
    name: "Fernanda Castro",
    role: "Directora Ejecutiva",
    bio: [
      "Arquitecta de la Pontificia Universidad Católica de Chile, Fernanda cuenta con más de una década de experiencia liderando equipos editoriales en el ámbito digital, dirigiendo la estrategia de contenidos en ArchDaily.",
      "Cofundadora de Casa Gris, espacio colaborativo y de exposición para artistas vinculados a la arquitectura, ha estado a cargo de su gestión, programación y curatoría desde 2015.",
      "Su trabajo fotográfico ha sido publicado en medios digitales e impresos, consolidando una visión estética que hoy impulsa desde Plinto.",
    ],
  },
  {
    name: "Diego Hernández",
    role: "Director Creativo",
    bio: [
      "Con más de una década de experiencia en medios, estrategia creativa y posicionamiento de marcas globales, Diego ha liderado proyectos de alto impacto entre arquitectura, comunicación y cultura urbana.",
      "Como Director de los Building of the Year Awards, coordinó producción, expansión internacional y relaciones con medios y arquitectos a nivel global.",
    ],
  },
  {
    name: "Cristian Pino Anguita",
    role: "Director Audiovisual",
    bio: [
      "Guionista, director y montajista chileno con carrera entre cine y digital. Actualmente director audiovisual en UCHTV.",
      "Ha dirigido proyectos documentales y piezas vinculadas a arquitectura, arte, Bienal de Arquitectura de Chile, ArchDaily y Fundación Techo.",
    ],
  },
  {
    name: "Soon",
    role: "Socios Colaboradores",
    bio: ["Social Media Expert", "Editor de contenidos"],
  },
];
---

<BaseLayout title="About" description="Equipo y mirada editorial de Plinto.">
  <SectionTitle title="Creamos contenido que posiciona y comunica a través de la estética y la coherencia." />
  <section class="page-section split">
    <p class="intro-copy">No venimos del marketing tradicional, sino de la arquitectura, la observación y el contenido creativo.</p>
    <div class="copy-stack">
      <p>Plinto es un estudio de estrategia, contenido y comunicación que construye marcas relevantes en el mundo de la arquitectura y la construcción a través de una narrativa coherente y distintiva.</p>
      <p>Contamos con más de 10 años de experiencia en creación de contenido y marcas de arquitectura. Trabajamos con una mirada editorial aplicada a un objetivo comercial.</p>
    </div>
  </section>
  <section class="page-section">
    <p class="kicker">Socios Colaboradores</p>
    <div class="people-grid">
      {
        people.map((person) => (
          <article class="person">
            <div>
              <h2>{person.name}</h2>
              <p>{person.role}</p>
            </div>
            <div>
              {person.bio.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
