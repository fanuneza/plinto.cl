---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkGrid from "../../components/WorkGrid.astro";

export async function getStaticPaths() {
  const works = await getCollection("work");
  return works.flatMap((work) => {
    const slug = work.id.replace(/\.mdx$/, "");
    const slugs = [slug, ...work.data.legacySlugs];
    return slugs.map((pathSlug) => ({
      params: { slug: pathSlug },
      props: { work, canonicalSlug: slug },
    }));
  });
}

const { work, canonicalSlug } = Astro.props;
const currentSlug = Astro.params.slug;
const isLegacySlug = currentSlug !== canonicalSlug;
const hasFeaturedGalleryTile = canonicalSlug !== "casa-kddk";
const canonicalPath = `/work/${canonicalSlug}/`;
const related = (await getCollection("work"))
  .filter((item) => item.id !== work.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
const heroSizes = "(max-width: 809px) calc(100vw - 40px), 1000px";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: work.data.title,
    description: work.data.seoDescription,
    image: new URL(work.data.coverImage.src, Astro.site).toString(),
    creator: {
      "@type": "Organization",
      name: "Plinto",
    },
    datePublished: String(work.data.year),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Work",
        item: new URL("/work/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: work.data.title,
        item: new URL(canonicalPath, Astro.site).toString(),
      },
    ],
  },
];
---

<BaseLayout
  title={work.data.seoTitle}
  description={work.data.seoDescription}
  image={work.data.coverImage.src}
  imageAlt={work.data.coverAlt}
  canonicalPath={canonicalPath}
  robots={isLegacySlug ? "noindex,follow,max-image-preview:large" : "index,follow,max-image-preview:large"}
  ogType="article"
  structuredData={structuredData}
>
  <article class="work-detail">
    <div class="work-hero">
      <h1>{work.data.title}</h1>
      <Image
        src={work.data.coverImage}
        alt={work.data.coverAlt}
        widths={[480, 800, 1200]}
        sizes={heroSizes}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        transition:name={`work-${work.id}`}
      />
    </div>
    <dl class="meta-grid">
      <div><dt>CLIENT</dt><dd>{work.data.client}</dd></div>
      <div><dt>SERVICE</dt><dd>{work.data.service}</dd></div>
      <div><dt>YEAR</dt><dd>{work.data.year}</dd></div>
    </dl>
    <div class="detail-sections">
      <section>
        <h2>01 - BRIEF</h2>
        <p>{work.data.brief ?? work.data.summary}</p>
      </section>
      <section>
        <h2>02 - SOLUTION</h2>
        <p>{work.data.solution ?? work.data.summary}</p>
      </section>
      <section>
        <h2>03 - DELIVERABLES</h2>
        <ul>
          {work.data.deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>
    <section>
      <h2 class="kicker">IMAGE GALLERY</h2>
      <ul class="gallery" data-lightbox-gallery>
        {
          work.data.gallery.map((image, index) => {
            const isFeatured = hasFeaturedGalleryTile && (index + 1) % 3 === 0;
            const gallerySizes = isFeatured
              ? "(max-width: 809px) calc(100vw - 40px), 1000px"
              : "(max-width: 809px) calc(100vw - 40px), (max-width: 1199px) calc(50vw - 32px), 491px";

            return (
              <li class:list={["gallery-item", { "gallery-item--featured": isFeatured }]}>
                <button
                  class="gallery-button"
                  type="button"
                  data-lightbox-trigger
                  data-src={image.src.src}
                  data-alt={image.alt}
                  data-caption={image.caption ?? image.alt}
                  aria-label={`Abrir imagen: ${image.caption ?? image.alt}`}
                >
                  <Image
                    src={image.src}
                    alt={image.alt}
                    widths={[480, 800, 1200]}
                    sizes={gallerySizes}
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                </button>
              </li>
            );
          })
        }
      </ul>
    </section>
    <section class="copy-stack detail-summary">
      <h2>SUMMARY</h2>
      <p>{work.data.summary}</p>
    </section>
    <section>
      <h2 class="kicker">READ MORE</h2>
      <WorkGrid items={related} />
    </section>
  </article>
  <dialog class="lightbox" data-lightbox-dialog aria-label="Vista ampliada de imagen">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Cerrar vista ampliada"> × </button>
    <figure class="lightbox__figure">
      <img class="lightbox__image" data-lightbox-image alt="" />
      <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
    </figure>
  </dialog>
  <script is:inline src="/scripts/lightbox.js" defer></script>
</BaseLayout>
