---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceList from "../components/ServiceList.astro";
import { FadeIn } from "../components/motion";

const items = [
  {
    icon: "house",
    title: "ARQUITECTOS",
    body: "Impulsamos la difusión de tu trabajo, rescatando la esencia de tu obra. Creamos una narrativa coherente que comunica tu visión, fortalece tu identidad de marca y gestiona estratégicamente los canales digitales para posicionar tu estudio y tus proyectos.",
    points: [
      "Posicionamiento de Marca (Branding)",
      "Registros Fotográficos y Videos (Storytelling)",
      "Kits de difusión (Content Marketing: Visual, Posts, Newsletters, Entrevistas, Micro-documentales)",
    ],
  },
  {
    icon: "building",
    title: "INMOBILIARIAS & CORREDORAS",
    body: "Promovemos los proyectos desde una mirada arquitectónica y estratégica. Creamos contenido atractivo, profesional y coherente que comunica el valor del diseño, potencia la identidad de cada proyecto.",
    points: [
      "Identidad de Marca (Branding)",
      "Narrativas de Proyectos (Storytelling)",
      "Kits de difusión (Content Marketing: Visual, Posts, Newsletters)",
    ],
  },
  {
    icon: "tree",
    title: "MARCAS & MATERIALES DE CONSTRUCCIÓN",
    body: "Desarrollo de una identidad de marca fuerte con un lenguaje visual cohesivo que resuene con su público, logrando mayor engagement y conversión.",
    points: [
      "Identidad de Marca (Branding)",
      "Estrategia de comunicación visual (Storytelling)",
      "Kits de difusión (Content Marketing: Visual, Posts, Newsletters)",
    ],
  },
  {
    icon: "lightbulb",
    title: "ASESORÍAS EN PROYECTOS & CONCURSOS",
    body: "Te ayudamos con la creación de material gráfico y editorial para distintas instancias (especiales y puntuales) como lanzamientos de productos, proyectos y postulaciones.",
    points: [
      "Lanzamientos y Campañas Especiales",
      "Estrategias comunicacionales para concursos",
      "Contenido gráfico y editorial para difusión de obras municipales, culturales, gubernamentales, etc",
    ],
  },
  {
    icon: "asterisk",
    title: "Nota al pie",
    body: "Plinto se dedica principalmente a la creación de estrategia e identidad de marca/proyectos/productos.\n\nNo somos una agencia de mantención de redes sociales, sin embargo, estamos abiertos a conversar y definir el plan de acción específico para tu caso.\n\nSi tienes dudas, escríbenos!",
  },
] as const;
---

<BaseLayout
  title="Nuestros Servicios y Clientes"
  description="Áreas, clientes y servicios de Plinto para arquitectura, inmobiliarias, marcas y concursos."
  bodyClass="service-page"
>
  <FadeIn>
    <SectionTitle title="SERVICIOS & CLIENTES" />
  </FadeIn>
  <section class="page-section">
    <ServiceList items={items} />
  </section>
</BaseLayout>
