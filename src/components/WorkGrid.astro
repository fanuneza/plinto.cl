---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { FadeHover } from "./motion";

interface Props {
  items: CollectionEntry<"work">[];
  limit?: number;
  eagerFirst?: boolean;
}

const { items, limit, eagerFirst = false } = Astro.props;
const visible = limit ? items.slice(0, limit) : items;
const cardSizes = "(max-width: 809px) calc(100vw - 40px), (max-width: 1199px) calc(50vw - 32px), 520px";
---

<ul class="work-grid">
  {
    visible.map((item, index) => {
      const isFirst = index === 0;
      const isEager = eagerFirst && isFirst;
      const slug = item.id.replace(/\.mdx$/, "");
      return (
        <li>
          <FadeHover client:visible delay={index * 0.08}>
            <a class="work-card" href={`/work/${slug}/`} transition:name={`work-${item.id}`}>
              <span class="work-media">
                <Image
                  src={item.data.coverImage}
                  alt={item.data.coverAlt}
                  widths={[480, 800, 1200]}
                  sizes={cardSizes}
                  loading={isEager ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={isEager ? "high" : "low"}
                />
              </span>
              <span class="work-meta">
                <span class="work-title">{item.data.title}</span>
                <span class="work-service">{item.data.service}</span>
                <span class="work-year">{item.data.year}</span>
                <span class="work-arrow" aria-hidden="true" />
              </span>
            </a>
          </FadeHover>
        </li>
      );
    })
  }
</ul>
