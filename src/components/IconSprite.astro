  </symbol>
  <symbol id="icon-tree" viewBox="0 0 24 24">
    <path d="M12 3 6.5 10h3L5 16h14l-4.5-6h3L12 3z"></path>
    <path d="M12 16v5"></path>
  </symbol>
  <symbol id="icon-lightbulb" viewBox="0 0 24 24">
