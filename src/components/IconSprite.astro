    <path d="M9.6 6.5h4.8M8.3 10h7.4M8.3 14h7.4M9.6 17.5h4.8"></path>
  </symbol>
  <symbol id="icon-mobile" viewBox="0 0 24 24">
    <rect x="7" y="2.5" width="10" height="19" rx="2"></rect>
    <path d="M11 18.5h2"></path>
  </symbol>
  <symbol id="icon-image" viewBox="0 0 24 24">
    <rect x="3" y="4.5" width="18" height="15" rx="2"></rect>
    <circle cx="8.75" cy="9.75" r="1.75"></circle>
    <path d="m4 18 4.6-4.6a2 2 0 0 1 2.8 0L16 18"></path>
    <path d="m14 16 1.6-1.6a2 2 0 0 1 2.8 0L20 16"></path>
  </symbol>
  <symbol id="icon-cluster" viewBox="0 0 24 24">
    <circle cx="12" cy="5.5" r="2.25"></circle>
    <circle cx="5.5" cy="18" r="2.25"></circle>
    <circle cx="18.5" cy="18" r="2.25"></circle>
    <path d="M10.9 7.5 6.6 15.9M13.1 7.5l4.3 8.4M7.75 18h8.5"></path>
  </symbol>
  <symbol id="icon-check" viewBox="0 0 24 24">
    <path d="m4.5 12.5 5 5 10-11"></path>
  </symbol>
  <symbol id="icon-arrow-right" viewBox="0 0 24 24">
    <path d="M4 12h15"></path>
    <path d="m13 6 6 6-6 6"></path>
  </symbol>
  <symbol id="icon-arrow-down" viewBox="0 0 24 24">
    <path d="M12 4v15"></path>
    <path d="m6 13 6 6 6-6"></path>
  </symbol>
  <symbol id="icon-chevron-left" viewBox="0 0 24 24">
