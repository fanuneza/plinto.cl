---
/**
 * Inline SVG sprite for the Plinto line-icon set.
 * Spec: 24x24 grid, 1.5px stroke, round caps/joins, 2px optical padding,
 * fill none, stroke currentColor (inherited from the <Icon> host element).
 * Rendered once per page, right after <body>.
 */
---

<svg class="icon-sprite" aria-hidden="true" focusable="false">
  <symbol id="icon-house" viewBox="0 0 24 24">
    <path d="M3 10.75 12 3.5l9 7.25"></path>
    <path d="M5.5 9.75V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.75"></path>
    <path d="M9.5 21v-6h5v6"></path>
  </symbol>
  <symbol id="icon-building" viewBox="0 0 24 24">
    <rect x="5" y="3" width="14" height="18" rx="1.5"></rect>
