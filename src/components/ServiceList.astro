---
import ServiceIcon from "./ServiceIcon.astro";
import { FadeHover } from "./motion";

interface Item {
  number?: string;
  title: string;
  icon?: "house" | "building" | "tree" | "lightbulb" | "asterisk" | "dna" | "mobile" | "image" | "cluster";
  body?: string;
  points?: readonly string[];
}

interface Props {
  items: readonly Item[];
  headingLevel?: "h2" | "h3";
}

const { items, headingLevel = "h2" } = Astro.props;
const fallbackIcons = ["house", "building", "tree", "lightbulb", "asterisk"] as const;
const Heading = headingLevel;
---

<ul class="service-list">
  {
    items.map((item, index) => (
      <li class="service-item">
        <FadeHover delay={index * 0.08} hoverScale={1.015} hoverY={-3}>
          <ServiceIcon name={item.icon ?? fallbackIcons[index % fallbackIcons.length]} />
          {item.number && <p class="service-number">{item.number}</p>}
          <Heading>{item.title}</Heading>
          {item.body && <p>{item.body}</p>}
          {item.points && (
            <ul>
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
        </FadeHover>
      </li>
    ))
  }
</ul>
