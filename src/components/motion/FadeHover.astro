---
interface Props {
  delay?: number;
  className?: string;
  hoverScale?: number;
  hoverY?: number;
  /** Skip scroll-triggered JS reveal and animate in immediately on load (use for above-the-fold content). */
  onLoad?: boolean;
}

const { delay = 0, className, hoverScale = 1.02, hoverY = -4, onLoad = false } = Astro.props;
const style = `--hover-scale: ${hoverScale}; --hover-y: ${hoverY}px;${delay ? ` --reveal-delay: ${delay}s;` : ""}`;
---

<div
  class:list={["reveal", onLoad && "load-fade-in", "reveal-hover", className]}
  data-reveal={onLoad ? undefined : ""}
  style={style}
>
  <slot />
</div>
