---
import { site, navItems, asset } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  bodyClass?: string;
}

const {
  title = "Plinto.cl",
  description = site.description,
  image = asset("brand/plinto-logo-stacked.png"),
  canonicalPath = Astro.url.pathname,
  bodyClass = "",
} = Astro.props;
const canonical = new URL(canonicalPath, site.url).toString();
const pageTitle = title === site.name ? title : `${title} | Plinto.cl`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.ico" type="image/x-icon" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url).toString()} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    <header class="site-header" data-reveal>
      <a class="brand" href="/" aria-label="Plinto home">plinto</a>
      <nav id="site-nav" aria-label="Principal">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <button class="mobile-menu-mark" type="button" aria-label="Abrir menu" aria-controls="site-nav" aria-expanded="false">
        <span aria-hidden="true"></span>
      </button>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <h2>CONTACTO</h2>
      <div class="footer-column footer-identity">
        <a class="footer-brand" href="/">Plinto.cl</a>
        <p>Santiago, Chile<br />2025</p>
      </div>
      <div class="footer-column">
        <p>Páginas</p>
        <a href="/">HOME</a>
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="footer-column">
        <p>Utility Pages</p>
        <a href="/404">404 PAGE</a>
      </div>
      <div class="footer-column">
        <p>Socials</p>
        <a href={site.instagram} rel="noopener">INSTAGRAM</a>
        <a href={site.linkedin} rel="noopener">LinkedIn</a>
      </div>
    </footer>
    <script is:inline src="/scripts/site.js"></script>
  </body>
</html>
