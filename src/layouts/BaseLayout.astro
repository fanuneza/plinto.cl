---
import { ClientRouter } from "astro:transitions";
import Seo from "@jdevalk/astro-seo-graph/Seo.astro";
import { buildSchemaGraph } from "../utils/schema";
import { site, navItems, asset } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalPath?: string;
  robots?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  schema?: Record<string, unknown>;
}

const {
  title = "Plinto",
  description = site.description,
  image = asset("brand/plinto-og-image.webp"),
  imageAlt = "Plinto",
  canonicalPath = Astro.url.pathname,
  robots = "index,follow,max-image-preview:large",
  ogType = "website",
  structuredData = [],
  bodyClass = "",
  schema,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).toString();
const themeColor = "#fffbf7";
const imageUrl = new URL(image, site.url).toString();
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const noindex = robots.includes("noindex");
const nofollow = robots.includes("nofollow");

// Auto-generate a base WebSite (home) or WebPage (all others) graph on every page.
// This ensures every page always emits a script[type="application/ld+json"].
const isHome = pathname === "/";
const baseGraph = buildSchemaGraph({
  pageType: isHome ? "website" : "webpage",
  url: canonical,
  title,
  description,
});

// Merge any page-specific schema nodes on top of the base graph.
// Pages can pass either a full @graph envelope or a single loose node.
if (schema) {
  if ("@graph" in schema && Array.isArray(schema["@graph"])) {
    // Page passes a full graph: merge its nodes
    (baseGraph["@graph"] as Record<string, unknown>[]).push(...(schema["@graph"] as Record<string, unknown>[]));
  } else {
    // Page passes a loose node: strip redundant @context and add it
    const { "@context": _ctx, ...node } = schema;
    (baseGraph["@graph"] as Record<string, unknown>[]).push(node);
  }
}

// Also absorb legacy structuredData items (existing page-level schemas)
const extraItems = (Array.isArray(structuredData) ? structuredData : [structuredData]).filter(Boolean);
for (const item of extraItems) {
  const { "@context": _ctx, ...node } = item as Record<string, unknown>;
  (baseGraph["@graph"] as Record<string, unknown>[]).push(node);
}
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />

    <Seo
      title={title}
      titleTemplate="%s | Plinto.cl"
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={nofollow}
      ogType={ogType}
      ogImage={imageUrl}
      ogImageAlt={imageAlt}
      ogImageWidth={1200}
      ogImageHeight={630}
      siteName="Plinto"
      locale="es_CL"
      graph={baseGraph}
      twitter={{ card: "summary_large_image" }}
      extraLinks={[
        { rel: "icon", href: "/assets/favicon.ico", type: "image/x-icon" },
        { rel: "manifest", href: "/site.webmanifest" },
        { rel: "dns-prefetch", href: "https://instagram.com" },
        { rel: "dns-prefetch", href: "https://linkedin.com" },
      ]}
    />

    <link
      rel="preload"
      href="/assets/fonts/satoshi/Satoshi-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/assets/fonts/inter/Inter-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link rel="preload" href="/assets/fonts/inter/Inter-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter fallback="animate" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Plinto home">plinto</a>
      <nav id="site-nav" aria-label="Principal">
        {
          navItems.map((item) => {
            const href = item.href.replace(/\/$/, "") || "/";
            const isCurrent = pathname === href || (href !== "/" && pathname.startsWith(`${href}/`));
            return (
              <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                {item.label}
              </a>
            );
          })
        }
      </nav>
      <button
        class="mobile-menu-mark"
        type="button"
        aria-label="Abrir menu"
        aria-controls="site-nav"
        aria-expanded="false"
      >
        <span aria-hidden="true"></span>
      </button>
    </header>
    <main id="content" tabindex="-1" transition:animate="fade">
      <slot />
    </main>
    <footer class="site-footer">
      <h2>CONTACTO</h2>
      <div class="footer-column footer-identity">
        <address>
          <p>Plinto.cl</p>
          <p>Santiago, Chile</p>
          <p>{currentYear}</p>
        </address>
      </div>
      <div class="footer-column">
        <h3>Páginas</h3>
        <a href="/">HOME</a>
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="footer-column">
        <h3>Socials</h3>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">INSTAGRAM</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
      <p class="footer-credit">
        <span>Design: Plinto.cl</span>
        <span class="footer-credit__separator" aria-hidden="true">·</span>
        <span
          >Dev: <a
            href="https://fnunez.cl/?utm_source=plinto.cl&utm_medium=referral&utm_campaign=credit_footer"
            target="_blank"
            rel="noopener noreferrer">Fabián Nuñez</a
          ></span
        >
      </p>
    </footer>
    <script is:inline src="/scripts/site.js" defer></script>
  </body>
</html>
